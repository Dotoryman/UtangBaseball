{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "utang-baseball",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["ADMIN_PASSWORD", "ADMIN_SESSION_SECRET"],
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "utangbaseball.cloud",
      "custom_domain": true,
    },
    {
      "pattern": "www.utangbaseball.cloud",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "utang-baseball-scores",
      "database_id": "a3bcbd4d-6c90-4b0e-b332-0a6e72b5386e",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SHARE_CARDS",
      "bucket_name": "utang-baseball-share-cards",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
  },
}
