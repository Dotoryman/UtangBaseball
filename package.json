{
  "name": "utang-baseball",
  "version": "1.2.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "assets:build": "node scripts/build-core-sprites.mjs && node scripts/build-v093-bats.mjs && node scripts/build-v121-art-hotfix.mjs && node scripts/build-v124-field-hotfix.mjs && node scripts/build-countdown-stickers-v120.mjs && node scripts/build-share-v073.mjs && node scripts/optimize-runtime-assets.mjs",
    "lint": "oxlint app lib",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "type": "module",
  "allowScripts": {
    "workerd@1.20260903.1": true,
    "esbuild@0.28.1": true
  }
}
